# Formspree form endpoint (Phase 5 — Contact page)
# Sign up at https://formspree.io and create a form for info@aitechinc.com
# Copy this file to .env and fill in your key — never commit .env
VITE_FORMSPREE_FORM_ID=your_form_id_here

# Public site URL for canonical links, Open Graph, and sitemap (Phase 7+)
# Production: https://www.aitechinc.com
# GitHub Pages staging (Phase 9): https://<username>.github.io/AIT/
VITE_SITE_URL=https://www.aitechinc.com
