# Formspree form endpoint (Contact page)
# Sign up at https://formspree.io and create a form for info@aitechinc.com
# Copy this file to .env and fill in your key — never commit .env
PUBLIC_FORMSPREE_FORM_ID=your_form_id_here

# Formspree form for Careers page job applications
# https://formspree.io/f/xrevdqop
PUBLIC_FORMSPREE_CAREERS_FORM_ID=xrevdqop

# Public site URL for canonical links, Open Graph, and sitemap
# Production: https://www.aitechinc.com
# GitHub Pages staging: https://<username>.github.io/AIT/
PUBLIC_SITE_URL=https://www.aitechinc.com

# Legacy VITE_* names are still supported for backward compatibility
VITE_FORMSPREE_FORM_ID=your_form_id_here
VITE_FORMSPREE_CAREERS_FORM_ID=xrevdqop
VITE_SITE_URL=https://www.aitechinc.com
