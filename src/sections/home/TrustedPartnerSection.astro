---
import HighlightCard from '../../shared/components/home/HighlightCard.astro'
import Container from '../../shared/components/ui/Container.astro'
import Prose from '../../shared/components/ui/Prose.astro'
import Section from '../../shared/components/ui/Section.astro'
import SectionHeading from '../../shared/components/ui/SectionHeading.astro'
import { homeContent } from '../../shared/content/site'

const { trustedPartner } = homeContent
---

<Section variant="white">
  <Container>
    <div class="fade-in">
      <p class="mb-3 text-sm font-medium uppercase tracking-[0.2em] text-teal">
        {trustedPartner.eyebrow}
      </p>
      <SectionHeading title={trustedPartner.title} showDivider />
      <Prose class="mb-10">{trustedPartner.body}</Prose>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          trustedPartner.highlights.map((highlight) => (
            <HighlightCard label={highlight.label} />
          ))
        }
      </div>
    </div>
  </Container>
</Section>
