---
import ClosingCta from '../../shared/components/ui/ClosingCta.astro'
import { homeContent, routes } from '../../shared/content/site'

const { finalCta } = homeContent
---

<ClosingCta
  headline={finalCta.headline}
  subline={finalCta.body}
  sectionVariant="gradient"
  large
  primaryLink={{ href: routes.contact, label: finalCta.primaryLabel, variant: 'secondary' }}
  secondaryLink={{
    href: routes.contact,
    label: finalCta.secondaryLabel,
    variant: 'ghost',
    class: 'border-white/30 text-white hover:border-white/50 hover:bg-white/10',
  }}
/>
