---
import BaseLayout from '../layouts/BaseLayout.astro'
import CareersApply from '../islands/CareersApply'
import ClosingCta from '../shared/components/ui/ClosingCta.astro'
import Container from '../shared/components/ui/Container.astro'
import PageHeader from '../shared/components/ui/PageHeader.astro'
import Section from '../shared/components/ui/Section.astro'
import SectionHeading from '../shared/components/ui/SectionHeading.astro'
import { careersContent, routes } from '../shared/content/site'
import Prose from '../shared/components/ui/Prose.astro'
---

<BaseLayout seoKey="careers">
  <PageHeader title="Careers" description={careersContent.pageSubtitle} />

  <Section variant="white">
    <Container>
      <div class="fade-in">
        <SectionHeading title={careersContent.cultureHeading} showDivider />
        <Prose>{careersContent.cultureBody}</Prose>
      </div>
    </Container>
  </Section>

  <Section variant="muted">
    <Container>
      <div class="fade-in">
        <SectionHeading title={careersContent.openingsHeading} showDivider />
        <CareersApply client:visible />
      </div>
    </Container>
  </Section>

  <ClosingCta
    headline={careersContent.closingCta.headline}
    subline={careersContent.closingCta.subline}
    primaryLink={{ href: routes.people, label: 'Our People', variant: 'secondary' }}
    secondaryLink={{
      href: routes.about,
      label: 'About AIT',
      variant: 'ghost',
      class: 'border-white/30 text-white hover:border-white/50 hover:bg-white/10',
    }}
  />
</BaseLayout>
