---
import BaseLayout from '../layouts/BaseLayout.astro'
import ContactDetails from '../shared/components/contact/ContactDetails.astro'
import ContactForm from '../islands/ContactForm'
import Container from '../shared/components/ui/Container.astro'
import PageHeader from '../shared/components/ui/PageHeader.astro'
import Section from '../shared/components/ui/Section.astro'
import { contactContent } from '../shared/content/site'
import { focusRing } from '../shared/lib/a11y'
import { cn } from '../shared/lib/cn'
---

<BaseLayout seoKey="contact">
  <PageHeader title="Contact" description={contactContent.welcome} />

  <Section variant="white">
    <Container>
      <div class="fade-in mx-auto w-full md:w-2/3">
        <ContactForm client:visible />
      </div>
    </Container>
  </Section>

  <Section variant="muted">
    <Container>
      <div class="grid items-start gap-10 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] md:gap-x-8 lg:gap-x-12 [&>*]:min-w-0">
        <div class="fade-in">
          <ContactDetails />
        </div>

        <div class="fade-in">
          <div class="w-full">
            <iframe
              title={contactContent.map.title}
              src={contactContent.map.embedUrl}
              width="100%"
              height="350"
              loading="lazy"
              class="rounded-xl border border-deep-teal/10 shadow-sm"
              referrerpolicy="no-referrer-when-downgrade"></iframe>
            <p class="mt-3 text-sm">
              <a
                href={contactContent.map.viewLargerUrl}
                target="_blank"
                rel="noopener noreferrer"
                class={cn('text-teal underline-offset-4 hover:underline', focusRing, 'rounded-sm')}
              >
                View Larger Map
              </a>
            </p>
          </div>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
