---
import BaseLayout from '../layouts/BaseLayout.astro'
import LocationGraphic from '../shared/components/home/LocationGraphic.astro'
import ClosingCta from '../shared/components/ui/ClosingCta.astro'
import Container from '../shared/components/ui/Container.astro'
import PageHeader from '../shared/components/ui/PageHeader.astro'
import Prose from '../shared/components/ui/Prose.astro'
import Section from '../shared/components/ui/Section.astro'
import SectionHeading from '../shared/components/ui/SectionHeading.astro'
import StatementCard from '../shared/components/ui/StatementCard.astro'
import ValueCard from '../shared/components/ui/ValueCard.astro'
import { aboutContent } from '../shared/content/site'
import { contentPairGrid, contentPairGridMediaFirst } from '../shared/lib/layout'

const foundationStatements = [
  aboutContent.vision,
  aboutContent.mission,
  aboutContent.purpose,
]
---

<BaseLayout seoKey="about">
  <PageHeader title="About Us" description={aboutContent.pageSubtitle} />

  <Section variant="white">
    <Container>
      <div class="fade-in">
        <SectionHeading title={aboutContent.howItStarted.title} showDivider />
        <Prose>{aboutContent.howItStarted.body}</Prose>
      </div>
    </Container>
  </Section>

  <Section variant="muted">
    <Container>
      <div class="fade-in">
        <SectionHeading
          title="Who We Are"
          subtitle={aboutContent.whoWeAre.subtitle}
          showDivider
        />
        <div class="grid gap-6 md:grid-cols-2 md:gap-x-10 md:gap-y-8 lg:gap-x-16">
          {aboutContent.whoWeAre.paragraphs.map((paragraph) => <Prose>{paragraph}</Prose>)}
        </div>
      </div>
    </Container>
  </Section>

  <Section variant="white">
    <Container>
      <div class="fade-in">
        <SectionHeading
          title={aboutContent.guidesHeading}
          subtitle={aboutContent.guidesSubtitle}
          showDivider
        />
        <div class="grid gap-6 md:grid-cols-3 md:gap-8">
          {
            foundationStatements.map((statement) => (
              <StatementCard title={statement.title} body={statement.body} />
            ))
          }
        </div>
      </div>
    </Container>
  </Section>

  <Section variant="muted">
    <Container>
      <div class="fade-in">
        <SectionHeading title={aboutContent.valuesHeading} showDivider />
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            aboutContent.values.map((value) => (
              <ValueCard title={value.title} description={value.description} />
            ))
          }
        </div>
      </div>
    </Container>
  </Section>

  <Section variant="white">
    <Container>
      <div class="fade-in">
        <SectionHeading title="NI Alliance Partner" showDivider />
        <div class={contentPairGridMediaFirst}>
          <div class="flex w-[220px] shrink-0 justify-center sm:w-[240px] md:w-[260px] md:justify-self-start">
            <img
              src={aboutContent.niBadge.src}
              alt={aboutContent.niBadge.alt}
              width={aboutContent.niBadge.width}
              height={aboutContent.niBadge.height}
              class="h-auto w-full max-w-[220px] md:max-w-[260px]"
            />
          </div>
          <Prose class="min-w-0">{aboutContent.niAlliance}</Prose>
        </div>
      </div>
    </Container>
  </Section>

  <Section variant="muted">
    <Container>
      <div class="fade-in">
        <SectionHeading title={aboutContent.reachHeading} showDivider />
        <div class={contentPairGrid}>
          <Prose class="min-w-0">{aboutContent.location}</Prose>
          <LocationGraphic />
        </div>
      </div>
    </Container>
  </Section>

  <ClosingCta
    headline={aboutContent.closingCta.headline}
    subline={aboutContent.closingCta.subline}
  />
</BaseLayout>
