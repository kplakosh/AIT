---
import { navItems, routes, siteConfig } from '../../content/site'
import type { NavItemGroup, NavItemLink } from '../../content/site'
import { focusRingOnDark } from '../../lib/a11y'
import { cn } from '../../lib/cn'
import Container from '../ui/Container.astro'
import Logo from '../ui/Logo.astro'

const pathname = Astro.url.pathname

const navGroups = navItems.filter((item): item is NavItemGroup => item.type === 'group')
const navTopLevelLinks = navItems.filter((item): item is NavItemLink => item.type === 'link')

function isActive(path: string): boolean {
  return path === '/' ? pathname === '/' : pathname.startsWith(path)
}

function isGroupActive(item: NavItemGroup): boolean {
  return item.items.some((link) => isActive(link.path))
}

const linkClass = (path: string) =>
  cn(
    'text-sm text-white/85 transition-colors hover:text-warm-gold',
    focusRingOnDark,
    isActive(path) && 'text-warm-gold',
  )
---

<footer class="mt-auto border-t border-white/10 bg-deep-teal text-white">
  <Container>
    <div class="flex flex-col gap-6 py-10 md:flex-row md:items-start md:justify-between md:gap-8">
      <div class="hidden shrink-0 items-center gap-4 md:flex lg:items-stretch lg:gap-6">
        <a href={routes.home} class={cn('shrink-0 rounded-md', focusRingOnDark)}>
          <Logo
            class="h-16 w-auto object-contain object-left lg:h-full lg:max-h-[5.5rem]"
            variant="on-dark"
          />
        </a>
        <p class="hidden max-w-xs items-center text-sm leading-relaxed text-white/75 lg:flex lg:max-w-sm">
          {siteConfig.tagline}
        </p>
      </div>

      <nav aria-label="Footer navigation" class="w-full min-w-0 md:ml-auto md:w-auto md:max-w-xl">
        <div class="grid grid-cols-3 gap-x-4 gap-y-4 sm:gap-x-6">
          {
            navGroups.map((group) => (
              <div class="min-w-0">
                <p
                  class={cn(
                    'mb-2 text-sm font-semibold text-white',
                    isGroupActive(group) && 'text-warm-gold',
                  )}
                >
                  {group.label}
                </p>
                <ul class="space-y-2">
                  {
                    group.items.map((link) => (
                      <li>
                        <a
                          href={link.path}
                          class={cn(linkClass(link.path), 'block')}
                          aria-current={isActive(link.path) ? 'page' : undefined}
                        >
                          {link.label}
                          {isActive(link.path) ? <span class="sr-only"> (current page)</span> : null}
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </div>
            ))
          }
          <div class="min-w-0">
            <ul class="space-y-2">
              {
                navTopLevelLinks.map((link) => (
                  <li>
                    <a
                      href={link.path}
                      class={cn(linkClass(link.path), 'block font-semibold text-white')}
                      aria-current={isActive(link.path) ? 'page' : undefined}
                    >
                      {link.label}
                      {isActive(link.path) ? <span class="sr-only"> (current page)</span> : null}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </nav>
    </div>

    <div class="border-t border-white/10 py-6">
      <p class="text-center text-sm text-white/60 md:text-left">{siteConfig.copyright}</p>
    </div>
  </Container>
</footer>
