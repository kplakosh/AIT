---
import { navLinks, siteConfig } from '../../content/site'
import { focusRingOnDark } from '../../lib/a11y'
import { cn } from '../../lib/cn'
import Container from '../ui/Container.astro'
import Logo from '../ui/Logo.astro'

const pathname = Astro.url.pathname

function isActive(path: string): boolean {
  return path === '/' ? pathname === '/' : pathname.startsWith(path)
}
---

<footer class="mt-auto border-t border-white/10 bg-deep-teal text-white">
  <Container>
    <div class="flex flex-col gap-8 py-10 md:flex-row md:items-stretch md:justify-between">
      <div class="flex items-stretch gap-4 sm:gap-6">
        <Logo
          class="h-20 w-auto shrink-0 object-contain object-left sm:h-24 md:h-full md:max-h-[5.5rem]"
          variant="on-dark"
        />
        <p class="flex max-w-xs items-center text-sm leading-relaxed text-white/75 sm:max-w-sm">
          {siteConfig.tagline}
        </p>
      </div>

      <nav aria-label="Footer navigation" class="flex flex-col justify-center gap-3 md:items-end">
        <p class="text-xs font-semibold uppercase tracking-wider text-warm-gold">Navigation</p>
        <div class="flex flex-col gap-2 sm:flex-row sm:gap-6">
          {
            navLinks.map(({ label, path }) => (
              <a
                href={path}
                class={cn(
                  'text-sm text-white/85 transition-colors hover:text-warm-gold',
                  focusRingOnDark,
                  isActive(path) && 'text-warm-gold',
                )}
                aria-current={isActive(path) ? 'page' : undefined}
              >
                {label}
                {isActive(path) ? <span class="sr-only"> (current page)</span> : null}
              </a>
            ))
          }
        </div>
      </nav>
    </div>

    <div class="border-t border-white/10 py-6">
      <p class="text-center text-sm text-white/60 md:text-left">{siteConfig.copyright}</p>
    </div>
  </Container>
</footer>
