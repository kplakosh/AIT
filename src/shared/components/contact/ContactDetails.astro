---
import { contactContent } from '../../content/site'
import { focusRing } from '../../lib/a11y'
import { cn } from '../../lib/cn'

const linkClasses = cn('text-teal underline-offset-4 hover:underline', focusRing, 'rounded-sm')
---

<address class="not-italic">
  <ul class="space-y-6">
    <li class="flex gap-4">
      <div
        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-teal/10 text-teal"
        aria-hidden="true"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z" />
          <path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2" />
          <path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2" />
          <path d="M10 6h4" /><path d="M10 10h4" /><path d="M10 14h4" /><path d="M10 18h4" />
        </svg>
      </div>
      <div>
        <p class="text-sm font-medium text-deep-teal">Company</p>
        <p class="body-text mt-1">{contactContent.company}</p>
      </div>
    </li>

    <li class="flex gap-4">
      <div
        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-teal/10 text-teal"
        aria-hidden="true"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" />
          <circle cx="12" cy="10" r="3" />
        </svg>
      </div>
      <div>
        <p class="text-sm font-medium text-deep-teal">Address</p>
        <p class="body-text mt-1">
          {contactContent.address.street}<br />
          {contactContent.address.suite}<br />
          {contactContent.address.city}
        </p>
      </div>
    </li>

    <li class="flex gap-4">
      <div
        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-teal/10 text-teal"
        aria-hidden="true"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path
            d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"
          />
        </svg>
      </div>
      <div>
        <p class="text-sm font-medium text-deep-teal">Phone</p>
        <p class="body-text mt-1">
          <a href={`tel:${contactContent.phone}`} class={linkClasses}>{contactContent.phone}</a>
        </p>
      </div>
    </li>

    <li class="flex gap-4">
      <div
        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-teal/10 text-teal"
        aria-hidden="true"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7" />
          <rect x="2" y="4" width="20" height="16" rx="2" />
        </svg>
      </div>
      <div>
        <p class="text-sm font-medium text-deep-teal">Email</p>
        <p class="body-text mt-1">
          <a href={`mailto:${contactContent.email}`} class={linkClasses}>{contactContent.email}</a>
        </p>
      </div>
    </li>
  </ul>
</address>
