---
import Container from './Container.astro'
import Section from './Section.astro'

type Props = {
  title: string
  description?: string
}

const { title, description } = Astro.props
---

<Section variant="gradient" class="py-10 md:py-14">
  <Container>
    <div class="max-w-3xl">
      <p class="mb-2 text-sm font-medium uppercase tracking-[0.2em] text-warm-gold">
        Advanced Instrument Technologies
      </p>
      <h1 class="font-heading text-3xl font-semibold tracking-tight text-white md:text-4xl">
        {title}
      </h1>
      {
        description ? (
          <p class="mt-4 text-base leading-relaxed text-white/90 md:text-lg">{description}</p>
        ) : null
      }
      <slot />
    </div>
  </Container>
</Section>
