---
import { assets } from '../../content/site'
import { cn } from '../../lib/cn'

type LogoVariant = 'default' | 'on-dark'

type Props = {
  class?: string
  variant?: LogoVariant
}

const { class: className = 'h-14 w-auto md:h-16', variant = 'default' } = Astro.props
const src = variant === 'on-dark' ? assets.logo.srcOnDark : assets.logo.src
---

<img
  src={src}
  alt={assets.logo.alt}
  class={cn(className)}
  width={346}
  height={140}
/>
