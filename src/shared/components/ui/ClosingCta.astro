---
import { routes } from '../../content/site'
import ButtonLink from './ButtonLink.astro'
import Container from './Container.astro'
import Section from './Section.astro'

type CtaLink = {
  href: string
  label: string
  variant?: 'primary' | 'secondary' | 'ghost'
  class?: string
}

type Props = {
  headline: string
  subline?: string
  primaryLink?: CtaLink
  secondaryLink?: CtaLink
}

const { headline, subline, primaryLink, secondaryLink } = Astro.props

const primary = primaryLink ?? {
  href: routes.contact,
  label: 'Contact Us',
  variant: 'secondary' as const,
}

const secondary = secondaryLink ?? {
  href: routes.services,
  label: 'View Services',
  variant: 'ghost' as const,
  class: 'border-white/30 text-white hover:border-white/50 hover:bg-white/10',
}
---

<Section variant="dark">
  <Container>
    <div class="fade-in mx-auto max-w-3xl text-center">
      <h2 class="font-heading text-2xl font-semibold tracking-tight text-white md:text-3xl">
        {headline}
      </h2>
      {
        subline ? (
          <p class="body-text-inverse mt-4">{subline}</p>
        ) : null
      }
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <ButtonLink href={primary.href} size="lg" variant={primary.variant ?? 'secondary'}>
          {primary.label}
        </ButtonLink>
        <ButtonLink
          href={secondary.href}
          size="lg"
          variant={secondary.variant ?? 'ghost'}
          class={secondary.class}
        >
          {secondary.label}
        </ButtonLink>
      </div>
    </div>
  </Container>
</Section>
