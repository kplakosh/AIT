---
type Props = {
  label: string
}

const { label } = Astro.props
---

<li class="flex items-center gap-3 rounded-lg border border-deep-teal/10 bg-cream/60 px-4 py-3.5 transition-colors hover:border-teal/20 hover:bg-cream">
  <span class="h-2 w-2 shrink-0 rounded-full bg-warm-gold" aria-hidden="true"></span>
  <span class="font-medium leading-snug text-deep-teal">{label}</span>
</li>
