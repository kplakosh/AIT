---
import Card from '../ui/Card.astro'

type Props = {
  label: string
}

const { label } = Astro.props
---

<Card variant="elevated" class="h-full text-center">
  <div
    class="mx-auto mb-4 flex h-10 w-10 items-center justify-center rounded-full bg-teal/10 text-teal"
    aria-hidden="true"
  >
    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M20 6 9 17l-5-5" />
    </svg>
  </div>
  <p class="font-heading text-base font-semibold leading-snug text-deep-teal md:text-lg">{label}</p>
</Card>
