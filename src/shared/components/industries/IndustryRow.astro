---
import ServiceBulletList from '../services/ServiceBulletList.astro'
import SectionHeading from '../ui/SectionHeading.astro'
import { cn } from '../../lib/cn'
import { contentPairGrid, contentPairGridMediaFirst } from '../../lib/layout'

type ImageData = {
  src?: string
  alt: string
}

type Props = {
  id: string
  title: string
  description: string | readonly string[]
  systems?: readonly string[]
  challenges: readonly string[]
  closing?: string
  image: ImageData
  imagePosition: 'left' | 'right'
}

const { id, title, description, systems, challenges, closing, image, imagePosition } = Astro.props

const descriptionParagraphs = typeof description === 'string' ? [description] : description

const gridClass = imagePosition === 'left' ? contentPairGridMediaFirst : contentPairGrid
---

<div id={id} class={cn('fade-in', gridClass)}>
  {
    imagePosition === 'left' ? (
      <div class="flex w-full justify-center md:max-w-lg md:justify-self-start">
        <div class="relative aspect-[4/3] w-full overflow-hidden rounded-xl border border-deep-teal/10 bg-white shadow-sm">
          {
            image.src ? (
              <img
                src={image.src}
                alt={image.alt}
                width={640}
                height={480}
                class="h-full w-full object-cover"
                loading="lazy"
              />
            ) : (
              <div
                class="flex h-full min-h-48 items-center justify-center bg-linear-to-br from-teal/5 to-cream p-8 text-center"
                role="img"
                aria-label={image.alt}
              >
                <span class="text-sm font-medium text-deep-teal/40">Industry image</span>
              </div>
            )
          }
        </div>
      </div>
    ) : null
  }

  <div class="min-w-0">
    <SectionHeading title={title} showDivider />
    {
      descriptionParagraphs.map((paragraph) => (
        <p class="body-text mt-4 first:mt-4">{paragraph}</p>
      ))
    }
    {
      systems ? (
        <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-x-8 lg:gap-x-10">
          <div class="min-w-0">
            <p class="text-sm font-medium text-deep-teal">Typical Systems We Support</p>
            <div class="mt-2">
              <ServiceBulletList items={systems} />
            </div>
          </div>
          <div class="min-w-0">
            <p class="text-sm font-medium text-deep-teal">Typical Challenges We Solve</p>
            <div class="mt-2">
              <ServiceBulletList items={challenges} />
            </div>
          </div>
        </div>
      ) : (
        <>
          <p class="mt-6 text-sm font-medium text-deep-teal">Typical Challenges We Solve</p>
          <div class="mt-2">
            <ServiceBulletList items={challenges} />
          </div>
        </>
      )
    }
    {closing ? <p class="body-text mt-6">{closing}</p> : null}
  </div>

  {
    imagePosition === 'right' ? (
      <div class="flex w-full justify-center md:max-w-lg md:justify-self-end">
        <div class="relative aspect-[4/3] w-full overflow-hidden rounded-xl border border-deep-teal/10 bg-white shadow-sm">
          {
            image.src ? (
              <img
                src={image.src}
                alt={image.alt}
                width={640}
                height={480}
                class="h-full w-full object-cover"
                loading="lazy"
              />
            ) : (
              <div
                class="flex h-full min-h-48 items-center justify-center bg-linear-to-br from-teal/5 to-cream p-8 text-center"
                role="img"
                aria-label={image.alt}
              >
                <span class="text-sm font-medium text-deep-teal/40">Industry image</span>
              </div>
            )
          }
        </div>
      </div>
    ) : null
  }
</div>
