---
type Props = {
  items: readonly string[]
}

const { items } = Astro.props
---

<ul class="space-y-3">
  {
    items.map((item) => (
      <li class="flex gap-3 text-navy-plum/85">
        <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-warm-gold" aria-hidden="true" />
        <span class="body-text">{item}</span>
      </li>
    ))
  }
</ul>
