dist/
dist-ssr/
build/
out/
*.class
*.exe

# System files
.DS_Store
Thumbs.db
Desktop.ini

# Editor & IDE settings
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs & cache
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
